APP_NAME=option-agent
APP_VERSION=0.2.0
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://option_agent:change-me@localhost:5432/option_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Groww Phase 1 - NEVER COMMIT REAL VALUES
# Option A: paste a currently valid Groww access token.
GROWW_ACCESS_TOKEN=

# Option B: use Groww API key + secret; the SDK exchanges them for an access token.
GROWW_API_KEY=
GROWW_API_SECRET=

# AI provider - reserved for later phases
LLM_API_KEY=
